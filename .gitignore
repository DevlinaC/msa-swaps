!/data/publication/S2/GREMLIN/provenance.json
!/data/publication/S2/MSA_Transformer/COMPLETE.json
!/data/publication/S2/MSA_Transformer/provenance.json
!/data/publication/S3/COMPLETE.json
!/data/publication/S3/provenance.json
!/figures/Figure_1/provenance.json
