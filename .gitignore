!/workflows/pairformer/results/analysis/VALIDATED.json
!/workflows/pairformer/results/rank_tolerant/VALIDATED.json

# Reviewed scientific tables and coordinates (2026-11-13).
# New files require a deliberate exception; retain local copies without upload.
*.[cC][sS][vV]
*.[pP][dD][bB]
*.[cC][iI][fF]
*.mmcif
*.mmCIF

